seen_posts = set()

def send_tg_message(text):
    url = f"https://api.telegram.org/bot{TG_TOKEN}/sendMessage"
    payload = {
        "chat_id": TG_CHAT_ID,
        "text": text,
        "disable_web_page_preview": False
    }
    try:
        requests.post(url, json=payload, timeout=10)
    except Exception as e:
        print(f"Ошибка отправки в Telegram: {e}")

def check_vk(first_run=False):
    print("Проверяю стену ВК...")
    try:
        response = requests.get(VK_WALL_URL, headers=headers, timeout=10)
        if response.status_code != 200:
            print(f"Ошибка загрузки ВК: {response.status_code}")
            return

        soup = BeautifulSoup(response.text, "html.parser")
        posts = soup.find_all("div", class_="pi_text")

        for post in posts:
            text = post.get_text()
            text_lower = text.lower()

            if text in seen_posts:
                continue

            if not first_run:
                if any(keyword in text_lower for keyword in KEYWORDS):
                    msg = f"🔍 Найдено объявление!\n\n{text[:300]}...\n\nИсточник: {VK_WALL_URL}"
                    send_tg_message(msg)
                    print("[+] Отправлено новое объявление в Telegram!")

            seen_posts.add(text)

    except Exception as e:
        print(f"Ошибка при проверке: {e}")

if __name__ == "__main__":
    print("Запуск бота...")
    check_vk(first_run=True)
